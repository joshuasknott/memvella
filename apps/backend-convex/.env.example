CONVEX_DEPLOYMENT=

# Better Auth runtime config used by Convex auth HTTP routes.
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
SITE_URL=
NEXT_PUBLIC_SITE_URL=
BETTER_AUTH_SECRET=
MEMVELLA_AUTH_PEPPER=

# Family account verification and password recovery email delivery.
RESEND_API_KEY=
MEMVELLA_AUTH_EMAIL_FROM=Memvella <accounts@example.com>

# E2E-only test support. The Playwright helper sets these on the Convex
# deployment temporarily; keep them unset for normal local development.
MEMVELLA_TEST_MODE=
MEMVELLA_TEST_AUTH_TOKEN=

# AI and live voice features.
GEMINI_API_KEY=

# Web push delivery worker.
NEXT_PUBLIC_MEMVELLA_WEB_PUSH_PUBLIC_KEY=
MEMVELLA_WEB_PUSH_PRIVATE_KEY=
MEMVELLA_WEB_PUSH_SUBJECT=mailto:support@example.com
