# Public app origin used by Better Auth and passkeys.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Optional legacy fallback still read by some server helpers.
SITE_URL=

# Convex
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Auth secrets
BETTER_AUTH_SECRET=
MEMVELLA_AUTH_PEPPER=

# Magic link email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=Memvella <no-reply@example.com>

# Gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=

# Web push notifications
NEXT_PUBLIC_MEMVELLA_WEB_PUSH_PUBLIC_KEY=
MEMVELLA_WEB_PUSH_PRIVATE_KEY=
MEMVELLA_WEB_PUSH_SUBJECT=mailto:support@example.com
